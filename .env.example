# Database Connection
DATABASE_URL="file:./dev.db"
TURSO_AUTH_TOKEN=""

# Auth
AUTH_SECRET="stakecontrol-local-dev-secret"

# Application Config
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_URL="http://localhost:3000"
REGISTRATION_ENABLED="true"
TRUST_CLOUDFLARE_PROXY="false"
CRON_SECRET=""

# Optional private QA controls. Only the listed accounts can switch their own plan.
PLAN_TESTER_EMAILS=""

# Private QA accounts allowed to generate demo records.
DEMO_DATA_EMAILS=""

# Transactional mail (Resend). EMAIL_FROM remains accepted as a legacy alias for EMAIL_DEFAULT_FROM.
EMAIL_PROVIDER="resend"
RESEND_API_KEY=""
EMAIL_FROM=""
EMAIL_DEFAULT_FROM=""
EMAIL_SECURITY_FROM=""
EMAIL_ALERTS_FROM=""
EMAIL_REPORTS_FROM=""
EMAIL_REPLY_TO=""
RESEND_WEBHOOK_SECRET=""

# Observability (Sentry). DSN is an ingest identifier; auth token is server-only.
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_ENVIRONMENT="development"
NEXT_PUBLIC_SENTRY_ENVIRONMENT="development"

# Optional, consent-based product analytics. Session replay and autocapture stay disabled.
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# Private ticket storage (required in production).
SUPABASE_URL=""
SUPABASE_SECRET_KEY=""
SUPABASE_STORAGE_BUCKET="tickets"

# OCR: "mock" | "tesseract" | "google_vision" | "aws_textract" | "azure_vision"
OCR_PROVIDER="mock"
TESSERACT_BIN="tesseract"
TESSERACT_LANG="spa+eng"
GOOGLE_VISION_CREDENTIALS_JSON=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AZURE_VISION_ENDPOINT=""
AZURE_VISION_KEY=""

# AI Integration Service. Keep mock for local development without an API key.
AI_PROVIDER="mock" # Global/report route: "mock" | "openai". Reports always remain on OpenAI in production.
OPENAI_API_KEY=""
AI_TICKET_PRIMARY_PROVIDER="openai"
AI_TICKET_FALLBACK_PROVIDER="openai"
AI_TICKET_OPENAI_FALLBACK_LIMIT_PER_MINUTE="300"
AI_TICKET_PRIMARY_MODEL="gpt-4.1-mini"
AI_TICKET_FALLBACK_MODEL="gpt-4.1-mini"
AI_REPORT_PRIMARY_MODEL="gpt-5-mini"
AI_REPORT_FALLBACK_MODEL="gpt-4.1-mini"
